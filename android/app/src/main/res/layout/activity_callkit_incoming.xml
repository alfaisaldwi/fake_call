<?xml version="1.0" encoding="utf-8"?>
<com.elumi.fakecalling.incoming.IncomingCallLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <com.elumi.fakecalling.incoming.FrontCameraPreviewView
        android:id="@+id/vFrontCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="video_only" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fwc_scrim" />

    <com.hiennv.flutter_callkit_incoming.widgets.RippleRelativeLayout
        android:id="@+id/llBackgroundAnimation"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:ripple_amount="1"
        app:ripple_color="#00000000" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="116dp">

        <TextView
            android:id="@+id/tvNameCaller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            tools:text="Arularavel" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.75"
            android:drawableStart="@drawable/fwc_ic_handle"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:text="Incoming video call" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:tag="voice_only" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_default_avatar"
            app:civ_border_width="0dp" />

        <TextView
            android:id="@+id/tvToggleVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fwc_pill"
            android:drawableStart="@drawable/fwc_ic_videocam_off"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:tag="video_only"
            android:text="@string/fwc_incoming_turn_off_video"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fwc_circle_decline" />

                <ImageView
                    android:id="@+id/ivDeclineCall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:backgroundTint="#00000000"
                    android:backgroundTintMode="src_in"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_decline"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="Decline" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="200dp">

                <com.elumi.fakecalling.incoming.SwipeHintChevrons
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="76dp" />

                <com.elumi.fakecalling.incoming.AcceptCallButton
                    android:id="@+id/ivAcceptCall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="36dp"
                    android:paddingTop="148dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_accept"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fwc_incoming_swipe_accept"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/flMessage"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/fwc_circle_message"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/fwc_ic_message"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fwc_incoming_message"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</com.elumi.fakecalling.incoming.IncomingCallLayout>
